index 62df88630..720230076 100644
--- a/components/sdlutil/sdlgraphicswindow.cpp
+++ b/components/sdlutil/sdlgraphicswindow.cpp
@@ -2,6 +2,10 @@
 
 #include <SDL_video.h>
 
+#ifdef OPENMW_IOS
+#include <dlfcn.h>
+#endif
+
 #ifdef OPENMW_GL4ES_MANUAL_INIT
 #include "gl4esinit.h"
 #endif
@@ -12,6 +16,39 @@
 
 namespace SDLUtil
 {
+#ifdef OPENMW_IOS
+    namespace
+    {
+        using NativeGetIntegerv = void (*)(GLenum, GLint*);
+
+        NativeGetIntegerv getNativeGetIntegerv()
+        {
+            static void* framework = dlopen(
+                "/System/Library/Frameworks/OpenGLES.framework/OpenGLES", RTLD_LAZY | RTLD_LOCAL);
+            static NativeGetIntegerv function = framework
+                ? reinterpret_cast<NativeGetIntegerv>(dlsym(framework, "glGetIntegerv"))
+                : nullptr;
+            return function;
+        }
+
+        void logNativeViewport(const char* milestone)
+        {
+            const NativeGetIntegerv getIntegerv = getNativeGetIntegerv();
+            if (!getIntegerv)
+            {
+                openmw_ios_log(milestone, "unavailable");
+                return;
+            }
+
+            GLint viewport[4] = { 0, 0, 0, 0 };
+            getIntegerv(GL_VIEWPORT, viewport);
+            const std::string dimensions = "viewport=" + std::to_string(viewport[0]) + ","
+                + std::to_string(viewport[1]) + "," + std::to_string(viewport[2]) + "x"
+                + std::to_string(viewport[3]);
+            openmw_ios_log(milestone, dimensions.c_str());
+        }
+    }
+#endif
 
