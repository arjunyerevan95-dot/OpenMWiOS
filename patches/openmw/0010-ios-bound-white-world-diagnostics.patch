+        void logBoundedSceneReadback(osg::State& state)
+        {
+            static std::size_t nextSample = 0;
+            constexpr std::array<unsigned int, 3> sampleFrames{ 600, 1200, 1800 };
+            if (nextSample >= sampleFrames.size() || !state.getFrameStamp()
+                || state.getFrameStamp()->getFrameNumber() < sampleFrames[nextSample])
+                return;
+
+            GLint viewport[4]{};
+            glGetIntegerv(GL_VIEWPORT, viewport);
+            const std::array<std::array<GLint, 2>, 5> coordinates{ {
+                { viewport[0] + viewport[2] / 2, viewport[1] + viewport[3] / 2 },
+                { viewport[0] + viewport[2] / 4, viewport[1] + viewport[3] / 4 },
+                { viewport[0] + viewport[2] * 3 / 4, viewport[1] + viewport[3] / 4 },
+                { viewport[0] + viewport[2] / 4, viewport[1] + viewport[3] * 3 / 4 },
+                { viewport[0] + viewport[2] * 3 / 4, viewport[1] + viewport[3] * 3 / 4 },
+            } };
+            std::array<std::array<GLubyte, 4>, 5> pixels{};
+            for (std::size_t i = 0; i < coordinates.size(); ++i)
+                glReadPixels(coordinates[i][0], coordinates[i][1], 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixels[i].data());
+
+            Log(Debug::Info) << "WO23 pre-UI scene sample frame=" << state.getFrameStamp()->getFrameNumber()
+                             << " viewport=" << viewport[0] << ',' << viewport[1] << ',' << viewport[2] << ','
+                             << viewport[3] << " rgba=" << static_cast<unsigned int>(pixels[0][0]) << ','
+                             << static_cast<unsigned int>(pixels[0][1]) << ','
+                             << static_cast<unsigned int>(pixels[0][2]) << ','
+                             << static_cast<unsigned int>(pixels[0][3]) << " | "
+                             << static_cast<unsigned int>(pixels[1][0]) << ','
+                             << static_cast<unsigned int>(pixels[1][1]) << ','
+                             << static_cast<unsigned int>(pixels[1][2]) << ','
+                             << static_cast<unsigned int>(pixels[1][3]) << " | "
+                             << static_cast<unsigned int>(pixels[2][0]) << ','
+                             << static_cast<unsigned int>(pixels[2][1]) << ','
+                             << static_cast<unsigned int>(pixels[2][2]) << ','
+                             << static_cast<unsigned int>(pixels[2][3]) << " | "
+                             << static_cast<unsigned int>(pixels[3][0]) << ','
+                             << static_cast<unsigned int>(pixels[3][1]) << ','
+                             << static_cast<unsigned int>(pixels[3][2]) << ','
+                             << static_cast<unsigned int>(pixels[3][3]) << " | "
+                             << static_cast<unsigned int>(pixels[4][0]) << ','
+                             << static_cast<unsigned int>(pixels[4][1]) << ','
+                             << static_cast<unsigned int>(pixels[4][2]) << ','
+                             << static_cast<unsigned int>(pixels[4][3]);
+            ++nextSample;
+        }
+    }
