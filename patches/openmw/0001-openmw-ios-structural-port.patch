     )
     FetchContent_MakeAvailable(osg)
 
+    # USED_OSG_PLUGINS is the canonical static registration list. A required
+    # registrar without a target is a configuration error, never an optional
+    # plugin to silently omit from the final executable.
+    foreach(_plugin IN LISTS USED_OSG_PLUGINS)
+        if(NOT TARGET ${_plugin})
+            message(FATAL_ERROR
+                "Required static OSG plugin target '${_plugin}' was not generated. "
+                "Check its package discovery and BUILD_OSG_PLUGIN_* prerequisites.")
+        endif()
+    endforeach()
+
+    if(OPENMW_IOS)
+        # OSG's plugin macros use the legacy plain target_link_libraries
+        # signature. Keep that signature here while using imported targets so
+        # their static dependency closures remain part of the link interface.
+        target_link_libraries(osgdb_png PNG::PNG ZLIB::ZLIB)
+        target_link_libraries(osgdb_jpeg JPEG::JPEG)
+        target_link_libraries(osgdb_freetype Freetype::Freetype)
+
+        add_library(openmw_ios_osg_plugins INTERFACE)
+        set(_openmw_ios_plugin_archives)
+        foreach(_plugin IN LISTS USED_OSG_PLUGINS)
+            add_dependencies(openmw_ios_osg_plugins ${_plugin})
+            list(APPEND _openmw_ios_plugin_archives "$<TARGET_FILE:${_plugin}>")
+            target_link_libraries(openmw_ios_osg_plugins INTERFACE
+                "$<TARGET_PROPERTY:${_plugin},LINK_LIBRARIES>")
+        endforeach()
+        get_whole_archive_options(_openmw_ios_plugin_options ${_openmw_ios_plugin_archives})
+        target_link_options(openmw_ios_osg_plugins INTERFACE ${_openmw_ios_plugin_options})
+    endif()
+
     set(OPENSCENEGRAPH_INCLUDE_DIRS ${osg_SOURCE_DIR}/include ${osg_BINARY_DIR}/include PARENT_SCOPE)
     set(OSG_LIBRARIES OpenThreads osg PARENT_SCOPE)
     foreach(_name ${USED_OSG_COMPONENTS})
