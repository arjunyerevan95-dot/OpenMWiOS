diff --git a/cmake/WholeArchive.cmake b/cmake/WholeArchive.cmake
index 0e4a09c..6f1f723 100644
--- a/cmake/WholeArchive.cmake
+++ b/cmake/WholeArchive.cmake
@@ -3,7 +3,15 @@ function (get_whole_archive_options OUT_VAR)
     if (CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
         set(${OUT_VAR} -Wl,--whole-archive ${ARGN} -Wl,--no-whole-archive PARENT_SCOPE)
     elseif (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
-        set(${OUT_VAR} -Wl,-all_load ${ARGN} -Wl,-noall_load PARENT_SCOPE)
+        # Apple's linker has no inverse for -all_load. Loading it before the
+        # plugin archives therefore affects every later static library, and
+        # -noall_load is rejected by current iOS linkers. Force-load each OSG
+        # plugin archive individually instead.
+        set(_whole_archive_options)
+        foreach(_archive IN LISTS ARGN)
+            list(APPEND _whole_archive_options "-Wl,-force_load,${_archive}")
+        endforeach()
+        set(${OUT_VAR} ${_whole_archive_options} PARENT_SCOPE)
     else ()
         message(FATAL_ERROR "get_whole_archive_options not implemented for CMAKE_CXX_COMPILER_ID ${CMAKE_CXX_COMPILER_ID}")
     endif()
