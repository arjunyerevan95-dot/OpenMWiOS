 namespace MWRender
 {
+    namespace
+    {
+        float terrainViewDistanceForProjection(float viewDistance, float verticalFov, double aspect)
+        {
+            const double halfFov = osg::DegreesToRadians(std::min(verticalFov, 140.f)) / 2.0;
+            const double tangent = std::tan(halfFov);
+            const double multiplier = std::sqrt(1.0 + tangent * tangent * (1.0 + aspect * aspect));
+            const double expandedDistance = static_cast<double>(viewDistance) * multiplier;
+            return static_cast<float>(
+                std::min(expandedDistance, static_cast<double>(std::numeric_limits<float>::max())));
+        }
+    }
