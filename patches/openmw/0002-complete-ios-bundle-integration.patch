diff --git a/components/files/macospath.cpp b/components/files/macospath.cpp
index 0b27d385d..e0347264a 100644
--- a/components/files/macospath.cpp
+++ b/components/files/macospath.cpp
@@ -97,7 +97,13 @@ namespace Files
 
     std::filesystem::path MacOsPath::getLocalPath() const
     {
+#ifdef OPENMW_IOS
+        // iOS application bundles use a flat layout. The executable and the
+        // bundled OpenMW configuration live directly inside the .app.
+        return getBinaryPath().parent_path();
+#else
         return getBinaryPath().parent_path().parent_path() / "Resources";
+#endif
     }
 
