+static GLuint defaultFramebuffer(void) {
+    return glstate->fbo.mainfbo_fbo ? glstate->fbo.mainfbo_fbo : glstate->fbo.default_fbo;
+}
+
+void gl4es_setDefaultFramebuffer(GLuint framebuffer, GLuint renderbuffer) {
+    glstate->fbo.default_fbo = framebuffer;
+    glstate->fbo.default_rbo = renderbuffer;
+
+    LOAD_GLES2_OR_OES(glBindFramebuffer);
+    LOAD_GLES2_OR_OES(glBindRenderbuffer);
+    if (glstate->fbo.current_fb && glstate->fbo.current_fb->id == 0 && gles_glBindFramebuffer)
+        gles_glBindFramebuffer(GL_FRAMEBUFFER, defaultFramebuffer());
+    if (glstate->fbo.current_rb == glstate->fbo.default_rb && gles_glBindRenderbuffer)
+        gles_glBindRenderbuffer(GL_RENDERBUFFER, glstate->fbo.default_rbo);
+}
+
+void gl4es_bindDefaultRenderbuffer(void) {
+    LOAD_GLES2_OR_OES(glBindRenderbuffer);
+    if (gles_glBindRenderbuffer)
+        gles_glBindRenderbuffer(GL_RENDERBUFFER, glstate->fbo.default_rbo);
+    glstate->fbo.current_rb = glstate->fbo.default_rb;
+}
