+        char detail[192];
+        std::snprintf(detail, sizeof(detail), "width=%d;height=%d;bytes=%u;texture=%u",
+            image->s(), image->t(), image->getImageSizeInBytes(), textureObject->id());
+        openmw_ios_renderer_diag_register_gl_texture(
+            textureObject->id(), hash, category, image->getFileName().c_str(), detail);
+#else
+        (void)textureObject;
+        (void)image;
+#endif
+    }
