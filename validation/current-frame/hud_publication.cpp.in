#include "apps/openmw/ios/openmw_ios_touch_targets.hpp"
#include <cassert>
#include <cmath>
#include <iostream>
namespace MyGUI
{
    struct Coord { int left,top,width,height; int right() const{return left+width;} int bottom() const{return top+height;} };
    struct Widget
    {
        Coord coord; Widget* parent=nullptr; bool visible=true,enabled=true;
        bool getVisible() const{return visible;} bool getEnabled() const{return enabled;}
        Widget* getParent() const{return parent;}
        Coord getAbsoluteCoord() const
        {
            auto c=coord;
            for(auto* p=parent;p;p=p->parent){c.left+=p->coord.left;c.top+=p->coord.top;}
            return c;
        }
    };
    struct RenderManager
    {
        struct Size{int width=1000,height=500;} size;
        static RenderManager& getInstance(){static RenderManager r;return r;}
        Size getViewSize() const{return size;}
    };
}
namespace MWBase
{
    struct WindowManager{bool gui=false;bool isGuiMode() const{return gui;}};
    struct Environment
    {
        WindowManager windows;
        static Environment& get(){static Environment e;return e;}
        WindowManager* getWindowManager(){return &windows;}
    };
}
namespace OpenMWIOS::Touch
{
    HudTargets published;
    void publishHudTargets(HudTargets targets){published=targets;}
}
struct Hud
{
    float mIosViewportScale=1.f;
    MyGUI::Widget root{{0,0,1000,500}},healthFrame{{30,400,100,10},&root},
        magickaFrame{{30,415,100,10},&root},staminaFrame{{30,430,100,10},&root},
        health{{0,0,100,10},&healthFrame},magicka{{0,0,100,10},&magickaFrame},stamina{{0,0,100,10},&staminaFrame},
        weapon{{150,400,40,40},&root},spell{{200,400,40,40},&root},minimap{{880,380,100,100},&root},
        canvas{{-600,-600,1800,1800},&minimap},
        mapButton{{0,0,1800,1800},&canvas},cursor{{500,250,16,16},&root};
    MyGUI::Widget *mHealthFrame=&healthFrame,*mHealth=&health,*mMagicka=&magicka,*mStamina=&stamina,
        *mWeapBox=&weapon,*mSpellBox=&spell,*mMinimap=&minimap,*mMinimapButton=&mapButton;
    void publish()
    {
// PRODUCTION_HUD_PUBLICATION
    }
};
int main()
{
    using namespace OpenMWIOS::Touch;
    Hud hud;hud.publish();
    assert(hudActionAt(published,.9f,.9f)==Action::Inventory);
    // Real minimap content canvas is much larger than its clipped viewport.
    // Camera swipes outside the visible map must not acquire Inventory.
    for (float x : {.55f,.7f,.85f,.99f})
        for (float y : {.1f,.3f,.5f,.7f})
            assert(hudActionAt(published,x,y)!=Action::Inventory);
    hud.canvas.coord.left=-1100;hud.canvas.coord.top=-900;hud.publish();
    assert(hudActionAt(published,.9f,.9f)==Action::Inventory);
    assert(!hudActionAt(published,.7f,.5f));
    assert(hudActionAt(published,.22f,.84f)==Action::ReadyMagic);
    assert(hudActionAt(published,.17f,.84f)==Action::ReadyWeapon);
    assert(!hudActionAt(published,.505f,.51f)); // moving cursor is not an Inventory target
    hud.minimap.coord={700,300,150,150};hud.spell.coord={250,350,60,60};hud.publish();
    assert(!hudActionAt(published,.9f,.9f)); // moved HUD has no stale corner zone
    assert(hudActionAt(published,.75f,.7f)==Action::Inventory);
    assert(hudActionAt(published,.28f,.75f)==Action::ReadyMagic);
    hud.minimap.visible=false;hud.spell.enabled=false;hud.publish();
    assert(!published.map.valid()&&!published.magic.valid());
    hud.root.visible=false;hud.publish();assert(hudHiddenActions(published)==0);
    hud.root.visible=true;MWBase::Environment::get().windows.gui=true;hud.publish();
    assert(hudHiddenActions(published)==0); // gameplay targets disappear in menus/modal UI
    MWBase::Environment::get().windows.gui=false;
    for (auto view : {MyGUI::RenderManager::Size{741,328},MyGUI::RenderManager::Size{1024,768}})
    {
        MyGUI::RenderManager::getInstance().size=view;
        hud.minimap.visible=true;
        hud.spell.enabled=true;
        hud.mIosViewportScale=1.f;
        hud.minimap.coord={view.width-80,view.height-80,61,61};
        hud.publish();
        const float defaultSize=published.map.right-published.map.left;
        hud.mIosViewportScale=.75f;
        hud.minimap.coord.left=static_cast<int>(std::lround(view.width/.75f))-80;
        hud.minimap.coord.top=static_cast<int>(std::lround(view.height/.75f))-80;
        hud.publish();
        const auto compact=published.map;
        assert(std::abs((compact.right-compact.left)/defaultSize-.75f)<.001f);
        assert(hudActionAt(published,(compact.left+compact.right)/2,(compact.top+compact.bottom)/2)==Action::Inventory);
        assert(!hudActionAt(published,.85f,.6f));
    }
    MyGUI::RenderManager::getInstance().size={0,0};hud.publish();assert(hudHiddenActions(published)==0);
    std::cout<<"PASS actual HUD publication: minimap/spell identity, moved/scaled widgets, visibility, GUI mode and empty viewport\n";
}

